FRONTEND_ORIGIN=http://localhost:5173
# YOLO (see README: Python 3.12 on Intel Mac; 3.11–3.13 on Apple Silicon / Windows)
# Named foods (grape, cheese, …): Ultralytics YOLO-World. Single-class boxes: best.pt.
# YOLO_MODEL=yolov8s-worldv2.pt
# YOLO_MODEL=best.pt
# YOLO_CLASSES=grape,cheese,apple,banana
# YOLO_CONF=0.25
# YOLO_IMGSZ=640
# Leave blank for sample recipes. Put your real key only in the ignored .env file.
BACKBOARD_API_KEY=
BACKBOARD_PROVIDER=openai
BACKBOARD_MODEL=gpt-4o
